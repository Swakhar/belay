<div class="card mb-6 p-6">
  <div class="mb-4 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-lg font-semibold text-slate-100"><%= @run.workflow %></h1>
      <p class="mt-1 font-mono text-xs text-slate-500">version <%= @run.workflow_version %> &middot; <%= @run.id %></p>
    </div>
    <span class="run-detail-status"><%= status_badge(@run.status) %></span>
  </div>

  <dl class="grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Started</dt>
      <dd class="mt-0.5 font-mono text-xs text-slate-300"><%= @run.started_at || "–" %></dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wide text-slate-500">Finished</dt>
      <dd class="mt-0.5 font-mono text-xs text-slate-300"><%= @run.finished_at || "–" %></dd>
    </div>
  </dl>
</div>
