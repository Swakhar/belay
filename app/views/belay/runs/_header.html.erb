<div class="mb-6 rounded-lg border border-slate-200 bg-white p-6">
  <div class="mb-4 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-xl font-semibold text-slate-900"><%= @run.workflow %></h1>
      <p class="text-sm text-slate-500">version <%= @run.workflow_version %> &middot; <%= @run.id %></p>
    </div>
    <span class="run-detail-status"><%= status_badge(@run.status) %></span>
  </div>

  <dl class="grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
    <div>
      <dt class="text-slate-500">Started</dt>
      <dd class="text-slate-900"><%= @run.started_at || "–" %></dd>
    </div>
    <div>
      <dt class="text-slate-500">Finished</dt>
      <dd class="text-slate-900"><%= @run.finished_at || "–" %></dd>
    </div>
  </dl>
</div>
