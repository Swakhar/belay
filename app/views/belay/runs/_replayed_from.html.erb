<div class="card mb-6 p-4 text-sm text-slate-400">
  Replayed from <%= link_to @run.replay_of_id, run_path(@run.replay_of), class: "font-mono text-violet-300 hover:text-violet-200" %>
  <% if @run.replay_model %>
    using <code class="rounded bg-slate-800 px-1 py-0.5 font-mono text-xs text-slate-300"><%= @run.replay_model %></code>
  <% end %>
  &middot; <%= link_to "view diff", diff_run_path(@run), class: "text-violet-300 hover:text-violet-200" %>
</div>
