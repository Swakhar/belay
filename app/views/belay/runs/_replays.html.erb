<div class="mb-6 rounded-lg border border-slate-200 bg-white p-4">
  <h2 class="mb-2 text-sm font-semibold text-slate-900">Replays</h2>
  <ul class="space-y-1 text-sm">
    <% @run.replays.each do |replay| %>
      <li>
        <%= link_to replay.id, run_path(replay), class: "text-sky-700 hover:underline" %>
        <% if replay.replay_model %>
          (<code class="rounded bg-slate-100 px-1 py-0.5 text-xs"><%= replay.replay_model %></code>)
        <% end %>
        &middot; <%= link_to "view diff", diff_run_path(replay), class: "text-sky-700 hover:underline" %>
      </li>
    <% end %>
  </ul>
</div>
