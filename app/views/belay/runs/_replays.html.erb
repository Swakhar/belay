<div class="card mb-6 p-4">
  <h2 class="mb-2 text-sm font-semibold text-slate-100">Replays</h2>
  <ul class="space-y-1 text-sm text-slate-400">
    <% @run.replays.each do |replay| %>
      <li>
        <%= link_to replay.id, run_path(replay), class: "font-mono text-violet-300 hover:text-violet-200" %>
        <% if replay.replay_model %>
          (<code class="rounded bg-slate-800 px-1 py-0.5 font-mono text-xs text-slate-300"><%= replay.replay_model %></code>)
        <% end %>
        &middot; <%= link_to "view diff", diff_run_path(replay), class: "text-violet-300 hover:text-violet-200" %>
      </li>
    <% end %>
  </ul>
</div>
