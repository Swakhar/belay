<div class="mb-6 flex items-center justify-between">
  <h1 class="text-xl font-semibold text-slate-100">Runs</h1>

  <%= form_with url: runs_path, method: :get, local: true, class: "flex items-center gap-2" do |f| %>
    <%= f.select :status, options_for_select(@statuses, params[:status]),
                 { include_blank: "All statuses" }, class: "select-field" %>
    <%= f.select :workflow, options_for_select(@workflows, params[:workflow]),
                 { include_blank: "All workflows" }, class: "select-field" %>
    <%= f.submit "Filter", class: "btn-secondary" %>
  <% end %>
</div>

<% if @runs.any? %>
  <div class="card overflow-hidden">
    <table class="min-w-full divide-y divide-slate-800 text-sm">
      <thead class="bg-slate-900/80">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wide text-slate-500">Workflow</th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wide text-slate-500">Status</th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wide text-slate-500">Started</th>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wide text-slate-500">Finished</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800">
        <% @runs.each do |run| %>
          <tr class="hover:bg-slate-800/60">
            <td class="px-4 py-2">
              <%= link_to run.workflow, run_path(run, return_to: request.fullpath),
                          class: "run-workflow font-medium text-violet-300 hover:text-violet-200" %>
            </td>
            <td class="run-status px-4 py-2"><%= status_badge(run.status) %></td>
            <td class="px-4 py-2 font-mono text-xs text-slate-500"><%= run.started_at %></td>
            <td class="px-4 py-2 font-mono text-xs text-slate-500"><%= run.finished_at %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @total_pages > 1 %>
    <div class="mt-4 flex items-center justify-between text-sm">
      <% if @page > 1 %>
        <%= link_to "← Previous", runs_path(pagination_params(request, @page - 1)), class: "pagination-prev btn-secondary" %>
      <% else %>
        <span class="btn-secondary pointer-events-none opacity-40">← Previous</span>
      <% end %>

      <span class="pagination-status text-slate-400">Page <%= @page %> of <%= @total_pages %></span>

      <% if @page < @total_pages %>
        <%= link_to "Next →", runs_path(pagination_params(request, @page + 1)), class: "pagination-next btn-secondary" %>
      <% else %>
        <span class="btn-secondary pointer-events-none opacity-40">Next →</span>
      <% end %>
    </div>
  <% end %>
<% else %>
  <div class="card border-dashed px-6 py-12 text-center">
    <p class="text-sm text-slate-500">No runs yet.</p>
  </div>
<% end %>
