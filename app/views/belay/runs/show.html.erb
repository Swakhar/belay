<%= render "belay/runs/header" %>

<% if @run.pending_gate %>
  <%= render "belay/runs/pending_gate" %>
<% end %>

<% if @run.pending_needs_review %>
  <%= render "belay/runs/pending_needs_review" %>
<% end %>

<h2 class="mb-4 text-lg font-semibold text-slate-900">Steps</h2>

<div>
  <%= render partial: "belay/runs/step", collection: @steps, as: :step %>
</div>
