<% if notice %>
  <div class="mb-6 rounded-md border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300" role="status">
    <%= notice %>
  </div>
<% end %>

<% if alert %>
  <div class="mb-6 rounded-md border border-rose-500/20 bg-rose-500/10 px-4 py-3 text-sm text-rose-300" role="alert">
    <%= alert %>
  </div>
<% end %>
