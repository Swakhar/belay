<div class="card overflow-hidden">
  <table class="min-w-full divide-y divide-slate-800 text-sm">
    <thead class="bg-slate-900/80">
      <tr>
        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wide text-slate-500">Date</th>
        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wide text-slate-500">Runs</th>
        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wide text-slate-500">Real API calls</th>
        <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wide text-slate-500">Per 100 runs</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-800">
      <% daily_stats.each do |day| %>
        <tr class="hover:bg-slate-800/60">
          <td class="stat-date px-4 py-2 font-mono text-xs text-slate-300"><%= day.date %></td>
          <td class="stat-runs px-4 py-2 font-mono text-xs text-slate-500"><%= day.runs %></td>
          <td class="stat-calls px-4 py-2 font-mono text-xs text-slate-500"><%= day.real_calls %></td>
          <td class="stat-rate px-4 py-2 font-mono text-xs font-medium text-slate-100"><%= day.calls_per_100_runs %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
