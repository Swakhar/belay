<!DOCTYPE html>
<html>
  <head>
    <title>Belay</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <style><%= raw Belay::Engine.stylesheet %></style>
  </head>
  <body class="bg-slate-50 font-sans text-slate-900 antialiased">
