<!DOCTYPE html>
<html>
  <head>
    <title>Belay</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <style><%= raw Belay::Engine.stylesheet %><%= raw Belay.config.custom_css %></style>
  </head>
  <body class="flex min-h-screen bg-slate-950 font-sans text-slate-100 antialiased">
    <%= render "belay/shared/sidebar" %>

    <main class="min-w-0 flex-1 px-6 py-8 sm:px-10">
      <div class="mx-auto max-w-4xl">
        <%= render "belay/shared/flash" %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
